# Copy to .env (git-ignored) and fill in. Never commit .env. Every variable is described in README.md.

# Required: a long random secret. It fixes the agent's address and wallet; keep it private and stable.
HC_AGENT_SEED=

# Agentverse API key (agentverse.ai, Profile, API Keys). The agent connects its own mailbox with it on start.
AGENTVERSE_API_KEY=

# ASI:One API key (asi1.ai, developer section). Optional: asi1 then parses free-text requests.
ASI_ONE_API_KEY=

# The Hypercompute gateway on this machine (loopback only; the owner token is read from it).
HC_GATEWAY_URL=http://127.0.0.1:8000

# Who may run prompts: comma-separated ASI:One sender addresses (agent1q...). The agent tells a refused sender
# their address, so message it once from ASI:One and copy yours here.
HC_ALLOWED_SENDERS=

# Everyone else: none | read (pool status) | paid (runs after a FET payment)
HC_GUEST_ACCESS=read
# Who pays: off | guests | everyone
HC_PAYMENTS=guests
# Show a review card before loading: auto | always | never
HC_CONFIRM=auto

# Optional
# HC_AGENT_HANDLE=hypercompute
# HC_AGENT_PORT=8460
# HC_STRATEGY=all_selected
# HC_DEFAULT_MAX_TOKENS=256
# HC_MAX_TOKENS_CAP=1024
# HC_RUNS_PER_WINDOW=4
# HC_RATE_WINDOW_S=600
# HC_KEEP_WARM_S=900
# HC_CHAT_EXTRA_JSON={"chat_template_kwargs": {"thinking": false}}
# HC_FET_NETWORK=stable-testnet
