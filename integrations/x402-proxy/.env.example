# Copy to .env (git-ignored) and fill in. Never commit or paste these values anywhere.
# --- Coinbase Developer Platform (portal.cdp.coinbase.com) ---
# Secret API key: Portal > API Keys > Create API key. Used by the CDP facilitator (seller) and CDP server wallets.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Wallet secret: Portal > Non-custodial Wallet > Security > Generate Wallet Secret. Only setup_wallets.py, buyer.py
# (--signer cdp) and payout.py need it; the proxy itself does not.
CDP_WALLET_SECRET=
# --- Seller ---
# PUBLIC Base Sepolia address that receives payments. setup_wallets.py fills it with a CDP wallet if left empty.
X402_PAY_TO=
# Friends' PUBLIC payout addresses: node display name (or node id) = address, comma separated.
X402_PAYEES=
# --- Optional, defaults shown ---
# X402_FACILITATOR=auto            # auto: CDP facilitator when the CDP key is set, else https://x402.org/facilitator
# X402_PRICE_BASE=$0.001           # flat part of every paid chat
# X402_PRICE_PER_1K=$0.02          # per 1,000 reserved completion tokens
# X402_DEFAULT_MAX_TOKENS=256
# X402_MAX_TOKENS_CAP=1024
# X402_HOST_FEE_BPS=1000           # 10% to the host before the layer split
# X402_MAX_INFLIGHT=1              # paid chats served at once
# X402_BIND=127.0.0.1              # 0.0.0.0 to let buyers on the LAN reach the proxy
# X402_PORT=8402
# HYPERCOMPUTE_GATEWAY=http://127.0.0.1:8001   # the gateway on this machine (the demo host's port)
