{
  "name": "hypercompute-convex-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pool Room: a live Convex room where anyone with the link can watch the Hypercompute pool and send it prompts",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "convex": "convex dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p convex"
  },
  "dependencies": {
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/rate-limiter": "0.4.2",
    "convex": "1.48.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "convex-test": "0.0.65",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
