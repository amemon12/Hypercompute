# Copy to bridge.env (git-ignored) on the host that runs the gateway. Never commit the real file.
# The bridge does nothing unless the first three are set.
HC_CONVEX_SITE_URL=https://NAME.convex.site
HC_ROOM_SECRET=paste-the-same-value-you-set-with-npx-convex-env-set
HC_ROOM_CODE=calhacks

# Optional
HC_GATEWAY_URL=http://127.0.0.1:8000
HC_ROOM_TITLE=Hypercompute Pool Room
HC_ROOM_MAX_TOKENS=48
# HC_ROOM_SLOTS=2            # default: the deployment's own slot count (engine_options.parallel)
# HC_ROOM_SYSTEM=...         # default: "reply in one or two short sentences"
