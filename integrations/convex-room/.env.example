# Copy to .env.local (git-ignored). `npx convex dev` writes CONVEX_DEPLOYMENT and VITE_CONVEX_URL for you.
VITE_CONVEX_URL=https://NAME.convex.cloud
# Optional: the public address the projector's QR code points at (e.g. the Vercel URL). Defaults to this page's origin.
VITE_PUBLIC_URL=
# Optional: room to open when the link has no ?room=
VITE_DEFAULT_ROOM=
